<!--
  Based on nav2_bt_navigator's stock navigate_to_pose_w_replanning_and_recovery.xml,
  with these behavior changes:
  1) A failed FollowPath tries one short collision-checked BackUp before
     replanning. This gives the robot room to turn when an obstacle is too
     close for an in-place Spin. If BackUp itself is unsafe, Spin remains a
     collision-checked fallback. A second FollowPath failure returns the goal
     to explore_lite for blacklisting instead of repeating the same retreat.
  2) The stock ReactiveFallback can let GoalUpdated skip recovery as soon as
     explore_lite submits a replacement goal. This tree performs its bounded
     recovery directly after a controller failure, then returns a second
     failure to explore_lite. This bounds recovery to one attempt per goal.
  3) 2026-09-13: added a SmoothPath step (nav2_smoother/SimpleSmoother, see
     nav2_params.yaml) right after ComputePathToPose - the raw NavFn grid path
     was being passed straight to FollowPath, and PathAlign closely tracking
     its 0.05m-cell stairsteps down a corridor looked like excessive
     side-to-side reorientation instead of a direct run.
  4) A PipelineSequence re-ticks its planner branch while FollowPath is
     running.  The RateController only reduced that re-plan rate: every tick
     still overwrote {path}, which Nav2 treats as a new FollowPath action and
     visibly aborts/stops the current controller action.  A normal Sequence
     plans and smooths once per navigation goal, then lets FollowPath run
     continuously.  Global replanning now occurs after a controller/planner
     failure and its recovery, or when explore_lite submits a new frontier.
     The local costmap and DWB controller remain active at their normal rate,
     so obstacle avoidance is not delayed.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- One recovery attempt and retry; then allow explore_lite to choose
         another frontier if the route is still blocked. -->
    <RecoveryNode number_of_retries="1" name="NavigateRecovery">
      <Sequence name="NavigateOnceThenFollow">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RecoveryNode number_of_retries="1" name="ComputePathToPose">
          <Sequence>
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="SimpleSmoother"/>
          </Sequence>
          <Sequence>
            <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
        </RecoveryNode>
        <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
      </Sequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <!-- Retreat 18 cm to make space before turning. BackUp checks the
             local costmap; the motor bridge also checks rear LiDAR continuously.
             If retreat is unsafe, try a collision-checked turn instead. -->
        <Fallback>
          <BackUp backup_dist="0.18" backup_speed="0.08" error_code_id="{backup_error_code}"/>
          <Spin spin_dist="0.60" error_code_id="{spin_error_code}"/>
        </Fallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
