[Unit]
Description=Start HamsiBot when GPIO26 boot switch is closed
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robotpi
WorkingDirectory=/home/robotpi/projects/robotpi
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/robotpi/projects/robotpi/.venv/bin/python /home/robotpi/projects/robotpi/scripts/start_app_if_boot_switch_closed.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target